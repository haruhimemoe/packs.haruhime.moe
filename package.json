{
  "name": "packs.haruhime.moe",
  "version": "0.1.0",
  "description": "Build an osu! beatmap pack from a tournament mappool: one download, a pack key, saved packs, a public pack list and an API.",
  "homepage": "https://packs.haruhime.moe",
  "bugs": "https://github.com/haruhimemoe/packs.haruhime.moe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/packs.haruhime.moe.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "standards": "next-kit check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@haruhimemoe/brand": "0.10.0",
    "@haruhimemoe/mirror": "0.1.0",
    "@haruhimemoe/next-kit": "0.16.0",
    "@haruhimemoe/osu": "0.7.0",
    "@haruhimemoe/pool": "0.3.0",
    "@haruhimemoe/ui": "0.24.0",
    "@haruhimemoe/vcs": "0.1.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.0",
    "better-auth": "1.7.7",
    "client-zip": "2.5.1",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.1",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lefthook": "2.2.1",
    "mongodb-memory-server": "11.3.0",
    "msw": "2.15.0",
    "parse-torrent": "11.0.24",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
