# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.
# The anonymous tool (build, key, zip, torrent) runs without any of these.
# Accounts, saved packs and the public pack list need the first four.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The app uses the "packs"
# database, and reads the haruhime.moe hub's "identity" database (users and sessions) on the same cluster.
# packs' database user needs readWrite on packs and only read on identity.
MONGODB_URI=

# The haruhime.moe hub's BETTER_AUTH_SECRET (the same value): packs checks the hub's session cookie with it.
# Sign-in itself runs only on the hub.
BETTER_AUTH_SECRET=

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an
# example) and secret. packs uses them for osu! API lookups (client credentials), not for sign-in.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# Optional. osu! user ids allowed into /admin, comma-separated, like 1234567,7654321. Empty means no admins.
ADMIN_OSU_IDS=

# Optional. Guards the daily pack stats job (/api/cron/pack-stats): Vercel Cron sends it as a Bearer token.
# At least 16 characters. Generate one with: openssl rand -base64 32. Empty means the job refuses every call.
CRON_SECRET=

# Optional. The token pools.haruhime.moe sends as a Bearer token to publish its packs (/api/service/pools/*).
# At least 32 characters. Generate one with: openssl rand -base64 48. Empty means those routes refuse every call.
POOLS_SERVICE_TOKEN=

# The haruhime.moe hub: sign-in, the account page and session refreshes. Empty means https://www.haruhime.moe.
HUB_URL=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
